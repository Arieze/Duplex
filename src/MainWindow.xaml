<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Duplex — Synchronisation de dossiers" Width="1320" Height="900" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#101319" Foreground="#F3F5F7" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#191E27" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E4E9EF" />
      <Setter Property="Background" Value="#293241" />
      <Setter Property="Padding" Value="17,11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EFF4FA" />
      <Setter Property="Background" Value="#11161F" />
      <Setter Property="BorderBrush" Value="#364253" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="CaretBrush" Value="#64E3C0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#CCD6E3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#DFE8F4" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBg" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="#3A505E" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="#294E49" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#DFE8F4" />
      <Setter Property="Background" Value="#283444" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#3A4A5E" BorderThickness="1" CornerRadius="5" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="10,0,25,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
              <TextBlock Text="⌄" Foreground="#A4B8D0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,4" IsHitTestVisible="False" />
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="#222E3C" BorderBrush="#405368" BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="330" Padding="4">
                  <ScrollViewer CanContentScroll="True">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#202834" />
      <Setter Property="Foreground" Value="#9EAFC4" />
      <Setter Property="Padding" Value="12,13" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#191E27" />
      <Setter Property="Foreground" Value="#E3EAF3" />
      <Setter Property="MinHeight" Value="46" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#232F3D" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#243E43" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
    </Style>
  </Window.Resources>
  <Grid Background="#101319">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="195" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#151A22" BorderBrush="#26303C" BorderThickness="0,0,1,0">
      <Grid Margin="22,30,18,23">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="⇄" FontSize="43" Foreground="#64E3C0" />
          <TextBlock Text="duplex" FontSize="29" FontWeight="Bold" Margin="0,0,0,7" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,45,0,0">
          <Border Background="#233B39" CornerRadius="7" Padding="13">
            <TextBlock Text="⇄   Synchroniser" Foreground="#83EACD" FontWeight="SemiBold" />
          </Border>
          <Button x:Name="HistoryButton" Content="↗   Sauvegardes" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,9,0,0" Padding="10,13" />
          <Button x:Name="HelpButton" Content="?   Aide" Background="Transparent" Padding="10,13" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,27,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,23">
        <StackPanel>
          <TextBlock Text="Synchronisation" FontSize="29" FontWeight="SemiBold" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C2D2C" CornerRadius="12" Padding="11,6">
          <TextBlock Text="●  Sauvegardes activées" Foreground="#79DCC2" FontSize="11" />
        </Border>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="46" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="A   PREMIER DOSSIER" FontSize="11" Foreground="#64E3C0" FontWeight="Bold" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathA" ToolTip="Chemin du dossier A. Vous pouvez déposer un dossier ici." AllowDrop="True" />
              <Button x:Name="BrowseA" Grid.Column="1" Content="…" FontSize="19" Margin="8,0,0,0" Padding="13,3" />
            </Grid>
          </StackPanel>
        </Border>
        <Button x:Name="SwapButton" Grid.Column="1" Content="⇄" ToolTip="Permuter les deux dossiers" FontSize="23" Background="Transparent" Padding="0" />
        <Border Grid.Column="2" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="B   SECOND DOSSIER" FontSize="11" Foreground="#9BB7FF" FontWeight="Bold" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PathB" ToolTip="Chemin du dossier B. Vous pouvez déposer un dossier ici." AllowDrop="True" />
              <Button x:Name="BrowseB" Grid.Column="1" Content="…" FontSize="19" Margin="8,0,0,0" Padding="13,3" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,17">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="235" />
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ModeBox" SelectedIndex="0">
              <ComboBoxItem Content="A → B · Mettre à jour B" />
              <ComboBoxItem Content="B → A · Mettre à jour A" />
              <ComboBoxItem Content="A ⇄ B · Fusionner" />
              <ComboBoxItem Content="A → B · Miroir de A" />
            </ComboBox>
            <TextBlock x:Name="ModeHint" Grid.Column="1" Text="Copie les ajouts et modifications de A vers B.&#xA;Les fichiers présents uniquement dans B restent en place." Foreground="#9EAFC3" FontSize="11" VerticalAlignment="Center" Margin="16,0" TextWrapping="Wrap" />
            <Button x:Name="CompareButton" Grid.Column="2" Content="Comparer" Background="#63DEBC" Foreground="#102723" FontWeight="SemiBold" />
          </Grid>
          <WrapPanel Margin="0,13,0,0">
            <CheckBox x:Name="HashOption" IsChecked="True" Content="Comparer le contenu" ToolTip="Compare le contenu des fichiers communs, même si la taille et la date sont identiques. Plus lent sur les gros dossiers." />
            <CheckBox x:Name="HiddenOption" IsChecked="True" Content="Fichiers cachés" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" Margin="0,0,0,15">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock x:Name="CountA" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="#73E1C1" />
            <TextBlock Text="Uniquement dans A" FontSize="11" Foreground="#93A4B9" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock x:Name="CountB" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="#9BB7FF" />
            <TextBlock Text="Uniquement dans B" FontSize="11" Foreground="#93A4B9" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock x:Name="CountDiff" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="#F7C37B" />
            <TextBlock Text="Contenus différents" FontSize="11" Foreground="#93A4B9" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <TextBlock x:Name="CountSame" Text="—" FontSize="23" FontWeight="SemiBold" Foreground="#A0ADBE" />
            <TextBlock x:Name="SameLabel" Text="Fichiers identiques" FontSize="11" Foreground="#93A4B9" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="12" ClipToBounds="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
              <ColumnDefinition Width="205" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SelectAllButton" Content="Tout cocher" Padding="10,7" Background="#253140" FontSize="11" />
            <Button x:Name="SelectNoneButton" Grid.Column="1" Content="Tout décocher" Padding="10,7" Background="Transparent" FontSize="11" Margin="5,0" />
            <CheckBox x:Name="DifferencesOnly" Grid.Column="2" Content="Différences uniquement" IsChecked="True" VerticalAlignment="Center" Margin="12,0" />
            <TextBox x:Name="SearchBox" Grid.Column="3" ToolTip="Rechercher dans les chemins" Padding="9,6" />
            <TextBlock Grid.Column="3" Text="Rechercher un fichier…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0" Foreground="#7E91AA" FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <DataGrid x:Name="FilesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="#191E27" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Single" IsReadOnly="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="40">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Actionable}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="FICHIER / CHEMIN RELATIF" Width="*" MinWidth="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Relative}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Relative}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="ÉTAT" Binding="{Binding Status}" Width="140" IsReadOnly="True" />
              <DataGridTextColumn Header="TAILLE A / B" Binding="{Binding Sizes}" Width="135" IsReadOnly="True" />
              <DataGridTemplateColumn Header="ACTION PRÉVUE" Width="165">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Actionable}" MinHeight="28" FontSize="11" Margin="0,2" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Border x:Name="EmptyPanel" Grid.Row="1" Background="#191E27">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <TextBlock Text="⇄" Foreground="#3F726C" FontSize="50" HorizontalAlignment="Center" />
              <TextBlock Text="Choisissez deux dossiers" FontSize="19" Margin="0,10,0,9" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Background="#161C25" Padding="15,11">
            <TextBlock x:Name="DetailText" Text="" Foreground="#8699AF" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>
      </Border>
      <Grid Grid.Row="5" Margin="0,17,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Prêt à comparer" FontWeight="SemiBold" />
          <TextBlock x:Name="SubStatus" Text="" Foreground="#8093A9" FontSize="11" Margin="0,5,15,0" TextWrapping="Wrap" />
          <ProgressBar x:Name="Progress" Height="3" Margin="0,10,20,0" Visibility="Collapsed" Foreground="#64E3C0" Background="#293341" />
        </StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Annuler" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center" />
        <Button x:Name="SyncButton" Grid.Column="2" Content="Synchroniser" Background="#63DEBC" Foreground="#102723" FontWeight="SemiBold" IsEnabled="False" VerticalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>